{
  "name": "blog",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:client": "vite build --mode client",
    "build:server": "vite build",
    "build": "vite build --mode client && vite build",
    "prepreview": "vite build --mode client && vite build",
    "preview": "wrangler pages dev ./dist",
    "predeploy": "vite build --mode client && vite build",
    "deploy": "wrangler pages deploy",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:type": "tsc --noEmit && tsc --noEmit -p src/client/tsconfig.json",
    "check": "pnpm check:type && oxlint . && prettier --check .",
    "check:fix": "pnpm check:type && oxlint . --fix && prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "wrangler pages dev ./dist",
    "sqlite": "sqlite3 $(find .wrangler/state/v3/d1 -name '*.sqlite' | head -1)"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.12",
    "@radix-ui/react-icons": "^1.3.2",
    "effect": "^3.21.0",
    "hono": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "valibot": "^1.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-cloudflare-pages": "^0.4.0",
    "@hono/vite-dev-server": "^0.17.0",
    "@storybook/html-vite": "^10.3.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.27.4",
    "oxlint": "^1.30.0",
    "prettier": "^3.6.2",
    "storybook": "^10.3.4",
    "typescript": "^5.6.0",
    "vite": "^6.1.1",
    "vitest": "^4.1.2",
    "wrangler": "^4.80.0"
  },
  "packageManager": "pnpm@10.26.2+sha512.0e308ff2005fc7410366f154f625f6631ab2b16b1d2e70238444dd6ae9d630a8482d92a451144debc492416896ed16f7b114a86ec68b8404b2443869e68ffda6"
}
